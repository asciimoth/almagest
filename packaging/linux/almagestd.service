[Unit]
Description=Almagest network daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/libexec/almagest/almagestd --isolation=off --discover-system-programs
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=almagestd
UMask=0077
RuntimeDirectory=almagest
RuntimeDirectoryMode=0755
Delegate=cpu memory pids
TasksMax=infinity
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETPCAP CAP_SETUID CAP_SYS_ADMIN
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
