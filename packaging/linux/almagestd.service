[Unit]
Description=Almagest isolated network daemon
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/libexec/almagest/almagest-isolation-storage prepare
ExecStart=/usr/libexec/almagest/almagestd --isolation=auto
Restart=on-failure
RestartSec=2s
UMask=0077
RuntimeDirectory=almagest
RuntimeDirectoryMode=0755
Delegate=cpu memory pids
TasksMax=infinity
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETPCAP CAP_SETUID CAP_SYS_ADMIN
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
