<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:difx="http://wixtoolset.org/schemas/v4/wxs/difxapp"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Almagest"
           Manufacturer="Almagest contributors"
           Version="$(var.Version)"
           ProductCode="$(var.ProductCode)"
           UpgradeCode="49768928-2421-453C-81CA-E962800EE5B8"
           Language="1033"
           Scope="perMachine"
           InstallerVersion="500">
    <SummaryInformation Description="Almagest network daemon"
                        Manufacturer="Almagest contributors" />
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade AllowSameVersionUpgrades="no"
                  DowngradeErrorMessage="A newer version of Almagest is already installed."
                  Schedule="afterInstallInitialize" />

    <util:QueryWindowsWellKnownSIDs />
    <Feature Id="AlmagestFeature" Title="Almagest" Description="Almagest service and desktop app"
             Level="1" AllowAbsent="no">
      <Feature Id="BackendFeature" Title="Almagest service"
               Description="Install the required network daemon service and command-line tools."
               Level="1" AllowAbsent="no">
        <ComponentRef Id="DaemonServiceComponent" />
        <ComponentRef Id="CliComponent" />
        <ComponentRef Id="WintunComponent" />
        <ComponentRef Id="PackageDocumentationComponent" />
        <ComponentRef Id="MullvadDriverComponent" />
        <ComponentRef Id="MullvadDriverServiceComponent" />
        <ComponentRef Id="ProgramDataAclComponent" />
        <ComponentGroupRef Id="LocalesComponents" />
        <ComponentGroupRef Id="ExamplesComponents" />
      </Feature>
      <Feature Id="DesktopAppFeature" Title="Desktop app"
               Description="Install the Almagest desktop and tray app."
               Level="1">
        <ComponentRef Id="DesktopAppComponent" />
        <Feature Id="DesktopAppAutoStartFeature" Title="Start app when users sign in"
                 Description="Start the desktop app in the notification area when a user signs in."
                 Level="1">
          <ComponentRef Id="DesktopAppAutoStartComponent" />
        </Feature>
      </Feature>
    </Feature>
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\LICENSE" />
    <CustomActionRef Id="RollbackAlmagestServiceRecovery" />
    <CustomActionRef Id="ConfigureAlmagestServiceRecovery" />
    <CustomActionRef Id="RollbackMullvadDriverService" />
    <CustomActionRef Id="CreateMullvadDriverService" />
    <CustomActionRef Id="ConfigureMullvadDriverService" />
    <CustomActionRef Id="DeleteMullvadDriverService" />
    <CustomActionRef Id="CreateAlmagestAdministrationGroup" />
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Almagest">
        <Directory Id="LOCALESFOLDER" Name="locales" />
        <Directory Id="EXAMPLESFOLDER" Name="examples" />
        <Directory Id="DRIVERSFOLDER" Name="drivers">
          <Directory Id="MULLVADDRIVERFOLDER" Name="mullvad-split-tunnel" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PROGRAMDATAFOLDER" Name="Almagest" />
    </StandardDirectory>
    <StandardDirectory Id="System64Folder">
      <Directory Id="SYSTEMDRIVERSFOLDER" Name="drivers" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <Component Id="DaemonServiceComponent" Directory="INSTALLFOLDER"
               Guid="C05707E1-C3A4-482D-B634-975B99A7F8AB" Bitness="always64">
      <File Id="DaemonExecutable" Source="$(var.PayloadDir)\almagestd.exe"
            KeyPath="yes" />
      <ServiceInstall Id="AlmagestServiceInstall"
                      Name="almagestd"
                      DisplayName="Almagest Network Daemon"
                      Description="Almagest network daemon"
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem"
                      Arguments="--isolation=off"
                      Vital="yes">
        <ServiceConfig Id="AlmagestServiceConfig"
                       DelayedAutoStart="yes"
                       FailureActionsWhen="failedToStopOrReturnedError"
                       OnInstall="yes"
                       OnReinstall="yes" />
      </ServiceInstall>
      <ServiceControl Id="AlmagestServiceControl"
                      Name="almagestd"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <Component Id="CliComponent" Directory="INSTALLFOLDER"
               Guid="D0351CF1-25F6-423B-ABCE-9C7F57FFD162" Bitness="always64">
      <File Id="CliExecutable" Source="$(var.PayloadDir)\almagest-cli.exe"
            KeyPath="yes" />
    </Component>

    <Component Id="DesktopAppComponent" Directory="INSTALLFOLDER"
               Guid="C3E680A8-1629-4788-8A31-765AF7D06C6A" Bitness="always64">
      <File Id="DesktopAppExecutable" Source="$(var.PayloadDir)\almagest-app.exe"
            KeyPath="yes" />
    </Component>

    <Component Id="DesktopAppAutoStartComponent" Directory="INSTALLFOLDER"
               Guid="CE97A2C4-E435-497A-BD0E-8211A38CF6B9" Bitness="always64">
      <RegistryValue Root="HKLM"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="Almagest"
                     Value="&quot;[#DesktopAppExecutable]&quot; --background"
                     Type="string" KeyPath="yes" />
    </Component>

    <Component Id="WintunComponent" Directory="INSTALLFOLDER"
               Guid="E029577A-A19D-4F4D-B5C3-666186CF4BE5" Bitness="always64">
      <File Id="WintunDll" Source="$(var.WintunDir)\wintun.dll"
            KeyPath="yes" />
    </Component>

    <Component Id="PackageDocumentationComponent" Directory="INSTALLFOLDER"
               Guid="1DA725CA-0E69-41D5-96D3-8803C5BDC55D" Bitness="always64">
      <File Id="ProjectLicense" Source="$(var.SourceDir)\LICENSE"
            Name="LICENSE.txt" KeyPath="yes" />
      <File Id="PackageReadme" Source="$(var.SourceDir)\packaging\windows\README.md"
            Name="PACKAGE-README.md" />
      <File Id="WintunLicense"
            Source="$(var.WintunDir)\..\licenses\wintun-LICENSE.txt"
            Name="WINTUN-LICENSE.txt" />
      <File Id="MullvadLicense"
            Source="$(var.MullvadDir)\..\licenses\mullvad-LICENSE-MPL.txt"
            Name="MULLVAD-LICENSE-MPL.txt" />
    </Component>

    <Component Id="MullvadDriverComponent" Directory="MULLVADDRIVERFOLDER"
               Guid="55D3B355-7A66-430A-9925-652983A9F03A" Bitness="always64">
      <File Id="MullvadDriverInf"
            Source="$(var.MullvadDir)\mullvad-split-tunnel.inf"
            KeyPath="yes" />
      <File Id="MullvadDriverSys"
            Source="$(var.MullvadDir)\mullvad-split-tunnel.sys" />
      <File Id="MullvadDriverCat"
            Source="$(var.MullvadDir)\mullvad-split-tunnel.cat" />
      <difx:Driver AddRemovePrograms="no"
                   DeleteFiles="yes"
                   ForceInstall="no"
                   Legacy="no"
                   PlugAndPlayPrompt="no"
                   Sequence="1" />
    </Component>

    <Component Id="ProgramDataAclComponent" Directory="PROGRAMDATAFOLDER"
               Guid="0FDB9BB0-8D49-41FA-8C2D-C12F11B284B8"
               Bitness="always64" KeyPath="yes" Permanent="yes">
      <CreateFolder>
        <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
      </CreateFolder>
    </Component>

    <Component Id="MullvadDriverServiceComponent" Directory="SYSTEMDRIVERSFOLDER"
               Guid="9C91CCED-DB8B-4CC1-A351-C8626319E222" Bitness="always64">
      <File Id="MullvadSystemDriver"
            Source="$(var.MullvadDir)\mullvad-split-tunnel.sys"
            KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <!-- MSI 5.0 returns access denied when ServiceConfigFailureActions applies
         this policy on Windows Server 2022. Configure the three distinct
         delays with a deferred, non-impersonated SCM command instead. The
         rollback action restores the package policy before service rollback. -->
    <CustomAction Id="RollbackAlmagestServiceRecovery"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]sc.exe&quot; failure almagestd reset= 86400 actions= restart/5000/restart/15000/restart/60000"
                  Execute="rollback"
                  Impersonate="no"
                  Return="check" />
    <CustomAction Id="ConfigureAlmagestServiceRecovery"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]sc.exe&quot; failure almagestd reset= 86400 actions= restart/5000/restart/15000/restart/60000"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <!-- DifxApp stages this primitive driver package but does not register its
         kernel service because its INF has no device models. The installed,
         signed SYS is the service binary. Normal upgrades keep the stable
         service registration while Windows Installer replaces the file. -->
    <CustomAction Id="RollbackMullvadDriverService"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]sc.exe&quot; delete mullvad-split-tunnel"
                  Execute="rollback"
                  Impersonate="no"
                  Return="ignore" />
    <CustomAction Id="CreateMullvadDriverService"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]sc.exe&quot; create mullvad-split-tunnel type= kernel start= demand error= normal binPath= \SystemRoot\System32\drivers\mullvad-split-tunnel.sys"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <CustomAction Id="ConfigureMullvadDriverService"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]sc.exe&quot; config mullvad-split-tunnel start= demand error= normal"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <CustomAction Id="DeleteMullvadDriverService"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]sc.exe&quot; delete mullvad-split-tunnel"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <!-- WiX 4.0.6 cannot create a local group declaratively. This action is
         idempotent across install, repair, and upgrade. The group is durable
         administrator-managed state, so uninstall and rollback keep it. -->
    <CustomAction Id="CreateAlmagestAdministrationGroup"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /d /c &quot;&quot;[SystemFolder]net.exe&quot; localgroup &quot;Almagest Administrators&quot; &gt;nul 2&gt;&amp;1 || &quot;[SystemFolder]net.exe&quot; localgroup &quot;Almagest Administrators&quot; /add /comment:&quot;Members can use the Almagest machine administration API.&quot;&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <InstallExecuteSequence>
      <Custom Action="DeleteMullvadDriverService"
              After="StopServices"
              Condition="REMOVE ~= &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RollbackMullvadDriverService"
              After="InstallServices"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="CreateMullvadDriverService"
              After="RollbackMullvadDriverService"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="ConfigureMullvadDriverService"
              After="CreateMullvadDriverService"
              Condition="NOT (REMOVE ~= &quot;ALL&quot;)" />
      <Custom Action="CreateAlmagestAdministrationGroup"
              After="ConfigureMullvadDriverService"
              Condition="NOT (REMOVE ~= &quot;ALL&quot;)" />
      <Custom Action="RollbackAlmagestServiceRecovery"
              After="CreateAlmagestAdministrationGroup"
              Condition="NOT (REMOVE ~= &quot;ALL&quot;)" />
      <Custom Action="ConfigureAlmagestServiceRecovery"
              After="RollbackAlmagestServiceRecovery"
              Condition="NOT (REMOVE ~= &quot;ALL&quot;)" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
