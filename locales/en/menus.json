      },
      "Network policies": {
        "items": {
          "outboundFailures": {
            "label": "Outbound failure policy",
            "help": "Retry failures or latch the outbound path until it is replaced."
          },
          "bandwidthRate": {
            "label": "Bandwidth rate (bytes/s)",
            "help": "Set rate and burst together. Zero disables the limit."
          },
          "bandwidthBurst": {
            "label": "Bandwidth burst (bytes)",
            "help": "Must be at least the bandwidth rate."
          },
          "connectionPadding": {
            "label": "Connection padding",
            "help": "Controls Tor connection padding."
          },
          "circuitPadding": {
            "label": "Circuit padding",
            "help": "Controls Tor circuit padding."
          },
          "reachableORPorts": {
            "label": "Reachable relay ports",
            "help": "Comma- or space-separated TCP ports. Empty permits all relay ports."
          },
          "maxPendingCircuits": {
            "label": "Maximum pending circuits",
            "help": "Zero uses the Tor default."
          },
          "numCPUs": {
            "label": "CPU count",
            "help": "Zero lets Tor detect the CPU count."
          },
          "clientIP": {
            "label": "Client IP policy",
            "help": "Selects the IP families Tor can use."
          },
          "onionTraffic": {
            "label": "Onion traffic",
            "help": "Controls access to onion services."
          },
          "entryNodes": {
            "label": "Entry relay fingerprints",
            "help": "One 40-character relay fingerprint per line."
          },
          "exitNodes": {
            "label": "Exit relay fingerprints",
            "help": "One 40-character relay fingerprint per line."
          },
          "excludeNodes": {
            "label": "Excluded relay fingerprints",
            "help": "One 40-character relay fingerprint per line."
          },
          "excludeExitNodes": {
            "label": "Excluded exit fingerprints",
            "help": "One 40-character relay fingerprint per line."
          },
          "strictNodes": {
            "label": "Strict relay selection",
            "help": "Do not use relays outside the configured lists."
          }
        }
      },
      "Networks": {
        "items": {
          "networks": {
            "label": "Tor Networks",
            "help": "Each entry creates one Network output. Per-connection circuits cannot use destination isolation.",
            "templates": {
              "network": {
                "label": "Network",
                "items": {
                  "name": {
                    "label": "Name",
                    "help": "Used in the graph port name."
                  },
                  "circuits": {
                    "label": "Circuit isolation",
                    "help": "Session reuses circuits. Connection creates a new circuit for every connection."
                  },
                  "isolateDestinationAddress": {
                    "label": "Isolate destination address",
                    "help": "Use a different circuit when the destination address changes."
                  },
                  "isolateDestinationPort": {
                    "label": "Isolate destination port",
                    "help": "Use a different circuit when the destination port changes."
                  }
                }
              }
            }
          }
        }
      },
      "Bridges": {
        "items": {
          "useBridges": {
            "label": "Use bridges",
            "help": "Route Tor bootstrap and relay traffic through the configured bridges."
          },
          "enableObfs4": {
            "label": "Enable obfs4",
            "help": "Enable the protected obfs4 or lyrebird transport executable."
          },
          "bridges": {
            "label": "Bridge lines",
            "help": "Add plain or obfs4 bridges. Enable bridge use before applying a non-empty list.",
            "templates": {
              "plain": {
                "label": "Plain bridge",
                "items": {
                  "address": {
                    "label": "Address",
                    "help": "Numeric bridge IP address and port."
                  },
                  "fingerprint": {
                    "label": "Fingerprint",
                    "help": "Optional 40-character relay fingerprint."
                  }
                }
              },
              "obfs4": {
                "label": "obfs4 bridge",
                "items": {
                  "address": {
                    "label": "Address",
                    "help": "Numeric bridge IP address and port."
                  },
                  "fingerprint": {
                    "label": "Fingerprint",
                    "help": "40-character relay fingerprint."
                  },
                  "obfs4Certificate": {
                    "label": "obfs4 certificate",
                    "help": "Base64 obfs4 certificate from the bridge line."
                  },
                  "iat": {
                    "label": "Inter-arrival timing"
                  }
                }
              }
            }
          }
        }
      },
      "Onion services": {
        "items": {
          "services": {
            "label": "Onion services",
            "help": "Each entry creates one persistent v3 onion service and one listen-only Network output.",
            "templates": {
              "service": {
                "label": "Onion service",
                "items": {
                  "name": {
                    "label": "Name",
                    "help": "Used in the graph port name."
                  },
                  "ports": {
                    "label": "Virtual ports",
                    "help": "Comma- or space-separated onion service ports."
                  },
                  "maxStreams": {
                    "label": "Maximum streams",
                    "help": "Zero uses the Tor default."
                  },
                  "maxStreamsPolicy": {
                    "label": "Stream limit policy"
                  },
                  "keySecret": {
                    "label": "Private key secret",
                    "help": "Empty creates a new node-scoped private key secret."
                  },
                  "authorizedClients": {
                    "label": "Authorized client public keys",
                    "help": "One v3 client authorization public key per line."
                  }
                }
              }
            }
          }
        }
      },
      "Client authorization": {
        "items": {
          "clientAuthorizations": {
            "label": "Client authorization",
            "help": "Add private authorization keys for connecting to protected v3 onion services.",
            "templates": {
              "authorization": {
                "label": "Authorization",
                "items": {
                  "address": {
                    "label": "Onion address"
                  },
                  "name": {
                    "label": "Key name",
                    "help": "Optional Tor authorization name."
                  },
                  "privateKeySecret": {
                    "label": "Private key secret",
                    "help": "Empty creates a new node-scoped X25519 private key secret."
                  }
                }
              }
            }
          }
        }
      }
    }
