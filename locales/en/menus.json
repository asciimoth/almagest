            "label": "Ephemeral node",
            "help": "Ask the control server to remove the machine after it goes offline."
          },
          "confirmPeers": {
            "label": "Require peer confirmation",
            "help": "Hold each newly observed control-provided peer outside WireGuard until a local administrator confirms it."
          },
          "listenPort": {
            "label": "Discovery UDP port",
            "help": "Local port for STUN, DISCO, and DERP path discovery. Zero selects an available port."
          },
          "disableDERP": {
            "label": "Disable DERP",
            "help": "Disable Tailscale TLS relay fallback."
          },
          "disableDiscovery": {
            "label": "Disable discovery",
            "help": "Disable endpoint discovery, STUN, and DISCO. Control-provided direct endpoints remain available."
          },
          "tlsConfig": {
            "label": "TLS config"
          }
        }
      },
