            "label": "Rule cache max entries",
            "help": "Maximum rule-cache entries. Zero uses the router default; a negative value disables the rule cache."
          },
          "routeCacheTTL": {
            "label": "Route cache TTL (ms)",
            "help": "How long route results are cached by packet flow. Zero inherits the rule-cache settings; a negative value disables the route cache."
          },
          "routeCacheMaxEntries": {
            "label": "Route cache max entries",
            "help": "Maximum route-result cache entries. Zero inherits the rule-cache settings or router default; a negative value disables the route cache."
          }
        }
      }
    }
  },
