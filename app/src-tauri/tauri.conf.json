{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Almagest",
  "version": "0.1.0",
  "identifier": "io.github.asciimoth.almagest",
  "build": {
    "frontendDist": "../frontend",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Almagest",
        "width": 900,
        "height": 600,
        "minWidth": 480,
        "minHeight": 320,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": {
        "default-src": "'none'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'"
      },
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../isolation"
        }
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
