// The client and server connect only to Public Peer. It routes their Yggdrasil
// traffic without an IP stack or application of its own.
// The bundled database contains fixed lab keys. They are public test data;
// never use them outside this example.
// Select Send request on HTTP Client to get a reply from HTTP Server.
{
	"nodes": {
		"HTTP Client": {
			"Class": "almagest/HttpClient",
			"Pos":   "{\"x\":20,\"y\":80}",
			"Links": ["Network -> [Client IP Stack] Network"],
			"url":   "http://[202:b29a:28f5:f219:a87a:6e8f:2b59:6597]:8080/",
		},
		"Client IP Stack": {
			"Class": "almagest/VTun",
			"Pos":   "{\"x\":260,\"y\":80}",
			"Links": ["Tun -> [Client Yggdrasil] Tun"],
			"mtu":   1280,
			"name":  "ygg-example-client",
		},
		"Client Yggdrasil": {
			"Class":            "almagest/Yggdrasil",
			"Pos":              "{\"x\":510,\"y\":80}",
			"Links":            ["default -> [Carrier Network] Network"],
			"privateKeySecret": "ygg-example-client-key",
			"peers":            "tcp://127.0.0.1:25390",
		},
		"Carrier Network": {
			"Class": "almagest/MockNetwork",
			"Pos":   "{\"x\":790,\"y\":280}",
		},
		"Public Peer": {
			"Class":            "almagest/Yggdrasil",
			"Pos":              "{\"x\":510,\"y\":280}",
			"Links":            ["default -> [Carrier Network] Network"],
			"privateKeySecret": "ygg-example-public-key",
			"listen":           "tcp://127.0.0.1:25390",
		},
		"HTTP Server": {
			"Class":    "almagest/HttpServer",
			"Pos":      "{\"x\":20,\"y\":480}",
			"Links":    ["Network -> [Server IP Stack] Network"],
			"host":     "202:b29a:28f5:f219:a87a:6e8f:2b59:6597",
			"port":     8080,
			"response": "Response through the Yggdrasil public peer",
		},
		"Server IP Stack": {
			"Class": "almagest/VTun",
			"Pos":   "{\"x\":260,\"y\":480}",
			"Links": ["Tun -> [Server Yggdrasil] Tun"],
			"mtu":   1280,
			"name":  "ygg-example-server",
		},
		"Server Yggdrasil": {
			"Class":            "almagest/Yggdrasil",
			"Pos":              "{\"x\":510,\"y\":480}",
			"Links":            ["default -> [Carrier Network] Network"],
			"privateKeySecret": "ygg-example-server-key",
			"peers":            "tcp://127.0.0.1:25390",
		},
	},
}
