{
	// Network and TUN firewalls example.
	"nodes": {
		"MockNetwork Firewall Target": {
			"Class":        "almagest/MockNetwork",
			"Pos":          "{\"x\":893,\"y\":92}",
			"allowAnyHost": true,
		},
		"HttpServer Network Firewall": {
			"Class":    "almagest/HttpServer",
			"Pos":      "{\"x\":614,\"y\":38}",
			"Links":    ["Network -> [MockNetwork Firewall Target] Network"],
			"host":     "network-firewall.local",
			"port":     18121,
			"response": "Network Firewall local example response",
		},
		"Network Firewall Example": {
			"Class": "almagest/NetworkFirewall",
			"Pos":   "{\"x\":639,\"y\":189}",
			"Links": ["Network -> [MockNetwork Firewall Target] Network"],
			"rules": {"exclude": [{"hosts": ["blocked.firewall.local"], "network": "tcp"}]},
		},
		"Network Firewall Object Policy": {
			"Class": "pasta/ObjectConstant",
			"Pos":   "{\"x\":318,\"y\":254}",
			"Links": ["output -> [Network Firewall Example] Config"],
			"value": {"exclude": [{"network": "udp"}]},
		},
		// curl --socks5-hostname 127.0.0.1:1184 http://network-firewall.local:18121/allowed
		"LocalProxy Network Firewall": {
			"Class":  "almagest/LocalProxy",
			"Pos":    "{\"x\":342,\"y\":138}",
			"Links":  ["proxy -> [Network Firewall Example] Network"],
			"wsPath": "/socks",
			"users":  [],
			"commands": {
				"cmdBind":          true,
				"cmdConnect":       true,
				"cmdGostMuxBind":   true,
				"cmdGostUDPTun":    true,
				"cmdTorResolve":    true,
				"cmdTorResolvePtr": true,
				"cmdUDPAssoc":      true,
			},
			"socksHost": "127.0.0.1",
			"socksPort": 1184,
			"wsHost":    "",
			"wsPort":    0,
		},

		"VTun Firewall Client": {
			"Class":          "almagest/VTun",
			"Pos":            "{\"x\":331,\"y\":352}",
			"Links":          ["Tun -> [TUN Firewall Example] Tun"],
			"endpointCh":     1024,
			"eventCh":        10,
			"noLoopbackAddr": false,
			"disableSACK":    false,
			"name":           "local-firewall-client",
			"localAddrs":     "10.214.0.1/24",
			"dnsServers":     "",
			"mtu":            1500,
		},
		"TUN Firewall Example": {
			"Class": "almagest/TunFirewall",
			"Pos":   "{\"x\":606,\"y\":377}",
			"Links": ["Tun -> [TunCopy Firewall Example] TunA"],
			"rules": {"exclude": [{"network": "tcp", "ports": [18123]}]},
		},
		"TUN Firewall Object Policy": {
			"Class": "pasta/ObjectConstant",
			"Pos":   "{\"x\":320,\"y\":465}",
			"Links": ["output -> [TUN Firewall Example] Config"],
			"value": {"exclude": [{"network": "udp", "ports": [18122]}]},
		},
		"TunCopy Firewall Example": {
			"Class": "almagest/TunCopy",
			"Pos":   "{\"x\":895,\"y\":403}",
		},
		"VTun Firewall Server": {
			"Class":          "almagest/VTun",
			"Pos":            "{\"x\":606,\"y\":528}",
			"Links":          ["Tun -> [TunCopy Firewall Example] TunB"],
			"eventCh":        10,
			"noLoopbackAddr": false,
			"disableSACK":    false,
			"name":           "local-firewall-server",
			"localAddrs":     "10.214.0.2/24",
			"dnsServers":     "",
			"mtu":            1500,
			"endpointCh":     1024,
		},
		"HttpClient TUN Firewall": {
			"Class":     "almagest/HttpClient",
			"Pos":       "{\"x\":69,\"y\":348}",
			"Links":     ["Network -> [VTun Firewall Client] Network"],
			"method":    "GET",
			"body":      "",
			"tlsConfig": "default",
			"url":       "http://10.214.0.2:18122/allowed",
		},
		"HttpServer TUN Firewall": {
			"Class":    "almagest/HttpServer",
			"Pos":      "{\"x\":338,\"y\":567}",
			"Links":    ["Network -> [VTun Firewall Server] Network"],
			"host":     "10.214.0.2",
			"port":     18122,
			"response": "TUN Firewall local example response",
		},
	},
}
