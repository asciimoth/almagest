{
	"nodes": {
		"HttpServer": {
			"Class":    "almagest/HttpServer",
			"Pos":      "{\"x\":476,\"y\":622}",
			"Links":    ["Network -> [MockNetwork] Network"],
			"response": "",
			"host":     "127.0.0.1",
			"port":     80
		},
    // curl -g --socks5-hostname 127.0.0.1:1081 http://google.com/example
		"LocalProxy": {
			"Class":  "almagest/LocalProxy",
			"Pos":    "{\"x\":277,\"y\":422}",
			"Links":  ["proxy -> [Sniffer] Network"],
			"wsPath": "/socks",
			"users":  [],
			"commands": {
				"cmdBind":          true,
				"cmdConnect":       true,
				"cmdGostMuxBind":   true,
				"cmdGostUDPTun":    true,
				"cmdTorResolve":    true,
				"cmdTorResolvePtr": true,
				"cmdUDPAssoc":      true
			},
			"socksHost": "127.0.0.1",
			"socksPort": 1081,
			"wsHost":    "",
			"wsPort":    0
		},
		"Sniffer": {
			"Class":               "almagest/Sniffer",
			"Pos":                 "{\"x\":465,\"y\":426}",
			"Links":               ["slot 1 -> [OutNetwork] Network", "slot 2 -> [MockNetwork] Network"],
			"rules":               "DIAL\nTCP\nAND\nINTERCEPT\n\nSNIFF HTTP URL:/example\nROUTE 2 DST:example.com:80\n\nSNIFF TLS ALPN:http/1.1\nSLOT 1\n\nSNIFF HTTP\nSLOT 1\n\nTRUE\nDROP",
			"dnsCacheStorageName": ""
		},
		"OutNetwork": {"Class": "almagest/OutNetwork", "Pos": "{\"x\":721,\"y\":425}"},
		"MockNetwork": {
			"allowAnyHost": true,
			"Class":        "almagest/MockNetwork",
			"Pos":          "{\"x\":727,\"y\":550}"
		}
	}
}
