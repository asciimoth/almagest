// Join a Tailscale network adds control-server peers, routes, DNS, and MTU
// settings to a WireGuard device.
// TailscaleCtrl uses one Network for control, discovery, and DERP. Direct peer
// UDP uses the separate Network on WireGuard.
// The controller uses the official Tailscale control service by default. Open
// its authorization link, approve the device, then replace the sample peer
// name and address. A compatible control server and an auth-key secret are
// optional.
{
	"nodes": {
		"MagicDNS Query": {
			"Class": "almagest/DnsQuery",
			"Pos":   "{\"x\":30,\"y\":110}",
			"Links": ["DNS -> [Tailscale Controller] DNS"],
			"name":  "peer.example.ts.net.",
		},
		"Tailnet Request": {
			"Class": "almagest/HttpClient",
			"Pos":   "{\"x\":30,\"y\":300}",
			"Links": ["Network -> [Tailnet IP Stack] Network"],
			"url":   "http://100.64.0.1/",
		},
		"Tailnet IP Stack": {
			"Class":          "almagest/VTun",
			"Pos":            "{\"x\":270,\"y\":300}",
			"Links":          ["Tun -> [Tailnet WireGuard] Tun"],
			"mtu":            1280,
			"name":           "tailscale-example",
		},
		"Tailnet WireGuard": {
			"Class":            "almagest/WireGuard",
			"Pos":              "{\"x\":525,\"y\":300}",
			"Links":            ["Network -> [Peer UDP Network] Network"],
		},
		"Tailscale Controller": {
			"Class": "almagest/TailscaleCtrl",
			"Pos":   "{\"x\":280,\"y\":110}",
			"Links": [
				"WireGuard -> [Tailnet WireGuard] WGCtrl",
				"Network -> [Control and Relay Network] Network",
			],
			"hostname":         "almagest-example",
		},
		"Control and Relay Network": {
			"Class": "almagest/OutNetwork",
			"Pos":   "{\"x\":570,\"y\":110}",
		},
		"Peer UDP Network": {
			"Class": "almagest/OutNetwork",
			"Pos":   "{\"x\":780,\"y\":300}",
		},
	},
}
