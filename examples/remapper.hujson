{
	"nodes": {
		"MockNetwork remapper examples": {
			"Class": "almagest/MockNetwork",
			"Pos":   "{\"x\":618,\"y\":370}"
		},
		"HttpClient remapper dst example": {
			"Class":  "almagest/HttpClient",
			"Pos":    "{\"x\":-68,\"y\":404}",
			"Links":  ["Network -> [Remapper dst] Network"],
			"url":    "http://127.0.0.1:18080/",
			"method": "GET",
			"body":   ""
		},
		"HttpServer remapper dst target": {
			"Class":    "almagest/HttpServer",
			"Pos":      "{\"x\":214,\"y\":134}",
			"Links":    ["Network -> [MockNetwork remapper examples] Network"],
			"host":     "127.0.0.1",
			"port":     8080,
			"response": "Remapper destination example"
		},
		"HttpServer remapper src example": {
			"Class":    "almagest/HttpServer",
			"Pos":      "{\"x\":-72,\"y\":546}",
			"Links":    ["Network -> [Remapper src] Network"],
			"response": "Remapper source example",
			"host":     "127.0.0.1",
			"port":     8081
		},
		"HttpClient remapper src example": {
			"Class":  "almagest/HttpClient",
			"Pos":    "{\"x\":206,\"y\":270}",
			"Links":  ["Network -> [MockNetwork remapper examples] Network"],
			"url":    "http://127.0.0.1:18081/",
			"method": "GET",
			"body":   ""
		},
		"Remapper src": {
			"Class": "almagest/Remapper",
			"Pos":   "{\"x\":265,\"y\":520}",
			"Links": ["Network -> [MockNetwork remapper examples] Network"],
			"rules": "# Server is configured for 127.0.0.1:8081, but the wrapped network listens on 127.0.0.1:18081.\nSRC PORT 18081 MATCH 127.0.0.1:8081 OP Listen"
		},
		"Remapper dst": {
			"Class": "almagest/Remapper",
			"Pos":   "{\"x\":268,\"y\":405}",
			"Links": ["Network -> [MockNetwork remapper examples] Network"],
			"rules": "# Client dials 127.0.0.1:18080, but the wrapped network receives 127.0.0.1:8080.\nDST PORT 8080 MATCH 127.0.0.1:18080 OP Dial"
		}
	}
}
