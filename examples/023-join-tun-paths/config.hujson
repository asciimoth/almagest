// Join TUN paths sends two independent client stacks through one flow
// converter.
// TunJoiner combines a default and secondary TUN path and learns which path
// owns each return flow.
// Send both requests. Their distinct source addresses let the joiner return
// each response to its correct stack.
{
	"nodes": {
		"Default Client": {
			"Class":     "almagest/HttpClient",
			"Pos":       "{\"x\":69,\"y\":78}",
			"Links":     ["Network -> [Default IP Stack] Network"],
			"url":       "http://10.223.0.10:8080/",
		},
		"Secondary Client": {
			"Class":     "almagest/HttpClient",
			"Pos":       "{\"x\":68,\"y\":316}",
			"Links":     ["Network -> [Secondary IP Stack] Network"],
			"url":       "http://10.223.0.10:8080/",
		},
		"Default IP Stack": {
			"Class":          "almagest/VTun",
			"Pos":            "{\"x\":250,\"y\":75}",
			"Links":          ["Tun -> [Path Joiner] Default"],
			"localAddrs":     "10.223.0.1/24",
			"name":           "default-client",
		},
		"Secondary IP Stack": {
			"Class":          "almagest/VTun",
			"Pos":            "{\"x\":250,\"y\":315}",
			"Links":          ["Tun -> [Path Joiner] Secondary"],
			"localAddrs":     "10.223.0.2/24",
			"name":           "secondary-client",
		},
		"Path Joiner": {
			"Class": "almagest/TunJoiner",
			"Pos":   "{\"x\":501,\"y\":191}",
			"Links": ["Tun -> [Shared Flow Converter] Tun"],
		},
		"Shared Flow Converter": {
			"Class":                "almagest/Spoofer",
			"Pos":                  "{\"x\":771,\"y\":194}",
			"Links":                ["Network -> [Target Network] Network"],
		},
		"Target Network": {
			"Class":        "almagest/MockNetwork",
			"Pos":          "{\"x\":1051,\"y\":115}",
		},
		"HTTP Server": {
			"Class":    "almagest/HttpServer",
			"Pos":      "{\"x\":794,\"y\":44}",
			"Links":    ["Network -> [Target Network] Network"],
			"host":     "10.223.0.10",
			"response": "Response through the joined TUN path",
		},
	},
}
