{
	"Logs": {
		"Cache": {"Debug": 16384, "Info": 2048, "Warn": 1024, "Error": 1024, "Fatal": 128},
	},
	"nodes": {
		"OutNetwork direct": {"Class": "almagest/OutNetwork"},
		"Amnesia VPN": {
			"Class": "almagest/Amnesia",
			"Links": ["Network -> [OutNetwork direct] Network"],
			"connectionSecret": "amnesia-activation",
			"serverCountryCode": "ge",
			"tlsConfig": "amnesia-tls",
			"gatewayURL": "https://amnesia.stack.test:18490",
			"gatewayPublicKeySecret": "amnesia-gateway-public",
			"storageID": "real-life-stack-amnesia",
			"enabled": true,
		},
		"VTun Amnesia": {
			"Class": "almagest/VTun",
			"Links": ["Tun -> [TunJoiner VPN] Secondary"],
			"name": "amnesia-transport",
			"localAddrs": "",
			"dnsServers": "",
			"mtu": 0,
			"endpointCh": 1024,
			"eventCh": 10,
			"noLoopbackAddr": false,
			"disableSACK": false,
		},
		"TunJoiner VPN": {
			"Class": "almagest/TunJoiner",
			"Links": ["Tun -> [Amnesia VPN] Tun"],
		},
		"DnsClient VPN": {
			"Class": "almagest/DnsClient",
			"Links": ["Network -> [VTun Amnesia] Network"],
			"servers": ["udp://%AMNESIA_IP%:53"],
		},
		"DnsCache vt": {
			"Class": "almagest/DnsCache",
			"Links": ["DNS -> [DnsClient VPN] DNS"],
			"storageName": "default",
			"reverseLookups": true,
			"writeOnly": false,
		},
		"DnsQuery public": {
			"Class": "almagest/DnsQuery",
			"Links": ["DNS -> [DnsCache vt] DNS"],
			"name": "public.stack.test.",
			"type": "A",
		},
		"DnsQuery intercepted": {
			"Class": "almagest/DnsQuery",
			"Links": ["DNS -> [DnsCache vt] DNS"],
			"name": "intercept-dns.stack.test.",
			"type": "A",
		},
		"TailscaleCtrl": {
			"Class": "almagest/TailscaleCtrl",
			"Links": [
				"WireGuard -> [WireGuard Tailscale] WGCtrl",
				"Network -> [VTun Amnesia] Network",
			],
			"enabled": true,
			"controlURL": "https://headscale.stack.test:18090",
			"tlsConfig": "headscale-tls",
			"hostname": "main",
			"authKeySecret": "headscale-auth-key",
			"listenPort": 41641,
			"disableDERP": true,
			"disableDiscovery": false,
			"storageID": "real-life-stack-tailscale",
		},
		"WireGuard Tailscale": {
			"Class": "almagest/WireGuard",
			"Links": ["Network -> [VTun Amnesia] Network"],
			"privateKeySecret": "wireguard-tailscale-private",
			"listenPort": 51820,
			"ownedIPs": "",
			"peers": [],
		},
		"DnsQuery tailnet": {
			"Class": "almagest/DnsQuery",
			"Links": ["DNS -> [TailscaleCtrl] DNS"],
			"name": "peer.stack.test.",
			"type": "A",
		},
		"TunSplitter VPN": {
			"Class": "almagest/TunSplitter",
			"Links": [
				"slot 1 -> [TunJoiner VPN] Default",
				"slot 2 -> [WireGuard Tailscale] Tun",
			],
			"rules": "SNET4 100.64.0.0/10\nSNET6 fd7a:115c:a1e0::/48\nOR\nSLOT 2\n\nTRUE\nSLOT 1",
		},
		"TunJoiner applications": {
			"Class": "almagest/TunJoiner",
			"Links": ["Tun -> [TunSplitter VPN] Tun"],
		},
		"VTun applications": {
			"Class": "almagest/VTun",
			"Links": ["Tun -> [TunJoiner applications] Secondary"],
			"name": "application-stack",
			"localAddrs": "",
			"dnsServers": "",
			"mtu": 0,
			"endpointCh": 1024,
			"eventCh": 10,
			"noLoopbackAddr": false,
			"disableSACK": false,
		},
		"HttpClient Tailnet": {
			"Class": "almagest/HttpClient",
			"Links": ["Network -> [VTun applications] Network"],
			"url": "http://100.64.0.1:18080/through-amnesia-and-tailscale",
			"method": "GET",
			"body": "",
		},
		"HttpClient A": {
			"Class": "almagest/HttpClient",
			"Links": ["Network -> [OutNetwork direct] Network"],
			"url": "http://%PUBLIC_IP%/http-client-a",
			"method": "GET",
			"body": "",
		},
		"HttpClient B": {
			"Class": "almagest/HttpClient",
			"Links": ["Network -> [VTun Amnesia] Network"],
			"url": "http://%PUBLIC_IP%/http-client-b",
			"method": "GET",
			"body": "",
		},
		"Proxy direct": {
			"Class": "almagest/LocalProxy",
			"Links": ["proxy -> [NetworkRouter direct] Network"],
			"socksHost": "127.0.0.1",
			"socksPort": 1081,
			"wsHost": "",
			"wsPort": 0,
			"wsPath": "/socks",
			"users": [],
			"commands": {
				"cmdBind": true,
				"cmdConnect": true,
				"cmdGostMuxBind": true,
				"cmdGostUDPTun": true,
				"cmdTorResolve": true,
				"cmdTorResolvePtr": true,
				"cmdUDPAssoc": true,
			},
		},
		"NetworkRouter direct": {
			"Class": "almagest/NetworkRouter",
			"Links": [
				"slot 1 -> [OutNetwork direct] Network",
				"DNS -> [DnsCache vt] DNS",
			],
			"rules": "ADDR_S intercept-hosts.stack.test\nADDR_S intercept-hosts.stack.test.\nOR\nADDR_S intercept-dns.stack.test\nOR\nADDR_S intercept-dns.stack.test.\nOR\nDROP\n\nTRUE\nSLOT 1",
			"dnsCacheStorageName": "default",
		},
		"Proxy Amnesia only": {
			"Class": "almagest/LocalProxy",
			"Links": ["proxy -> [NetworkRouter Amnesia only] Network"],
			"socksHost": "127.0.0.1",
			"socksPort": 1082,
			"wsHost": "",
			"wsPort": 0,
			"wsPath": "/socks",
			"users": [],
			"commands": {
				"cmdBind": true,
				"cmdConnect": true,
				"cmdGostMuxBind": true,
				"cmdGostUDPTun": true,
				"cmdTorResolve": true,
				"cmdTorResolvePtr": true,
				"cmdUDPAssoc": true,
			},
		},
		"NetworkRouter Amnesia only": {
			"Class": "almagest/NetworkRouter",
			"Links": [
				"slot 1 -> [TlsMitm intercepted] Network",
				"slot 2 -> [MockNetwork intercepted] Network",
				"slot 3 -> [VTun Amnesia] Network",
				"DNS -> [DnsCache vt] DNS",
			],
			"rules": "ADDR_S intercept-hosts.stack.test\nADDR_S intercept-hosts.stack.test.\nOR\nADDR_S intercept-dns.stack.test\nOR\nADDR_S intercept-dns.stack.test.\nOR\nPORT 443\nAND\nSLOT 1\n\nADDR_S intercept-hosts.stack.test\nADDR_S intercept-hosts.stack.test.\nOR\nADDR_S intercept-dns.stack.test\nOR\nADDR_S intercept-dns.stack.test.\nOR\nPORT 80\nAND\nSLOT 2\n\nTRUE\nSLOT 3",
			"dnsCacheStorageName": "default",
		},
		"TlsMitm intercepted": {
			"Class": "almagest/TlsMitm",
			"Links": ["Network -> [TlsTerminator intercepted] Network"],
			"filterMode": "inclusive",
			"filterRules": "[{\"sni_hosts\":[\"intercept-hosts.stack.test\",\"intercept-dns.stack.test\"]}]",
			"leafTTLSeconds": 300,
			"sniffBufferSize": 8192,
			"tlsConfig": "default",
		},
		"TlsTerminator intercepted": {
			"Class": "almagest/TlsTerminator",
			"Links": ["Network -> [MockNetwork intercepted] Network"],
			"destinationRemaps": "[{\"sni_hosts\":[\"intercept-hosts.stack.test\",\"intercept-dns.stack.test\"],\"dst\":\"127.0.0.1:80\"}]",
			"leafTTLSeconds": 300,
			"serverAlpn": "http/1.1",
			"sniffBufferSize": 8192,
			"useSNIHostname": false,
		},
		"MockNetwork intercepted": {
			"Class": "almagest/MockNetwork",
			"allowAnyHost": true,
		},
		"HttpServer intercepted": {
			"Class": "almagest/HttpServer",
			"Links": ["Network -> [MockNetwork intercepted] Network"],
			"host": "127.0.0.1",
			"port": 80,
			"response": "intercepted stack target",
		},
		"Tun2Dns default": {
			"Class": "almagest/Tun2Dns",
			"Links": ["DNS -> [DnsCache vt] DNS"],
		},
		"TunSplitter lH": {
			"Class": "almagest/TunSplitter",
			"Links": [
				"slot 1 -> [TunJoiner applications] Default",
				"slot 2 -> [Tun2Dns default] Tun",
			],
			"rules": "ADDR_S %EXAMPLE_IP%\nADDR_S intercept-dns.stack.test\nOR\nADDR_S intercept-dns.stack.test.\nOR\nDROP\n\nRULE cmd blocked-fetch\nRULE comm blocked-fetch\nOR\nDROP\n\nPORT 53\nSLOT 2\n\nTRUE\nSLOT 1",
			"dnsCacheStorageName": "default",
		},
		"DefaultTun": {
			"Class": "almagest/DefaultTun",
			"Links": ["Tun -> [TunSplitter lH] Tun", "DNS -> [DnsCache vt] DNS"],
			"tunAddrs": "",
			"tunRoutes": "",
			"mtu": 0,
			"dnsIP": "",
			"strict": false,
			"exclude": [{"type": "comm", "rule": "^(direct-fetch|direct-fetch-cu)$"}],
			"include": [],
		},
	},
}
