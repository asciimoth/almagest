{
	"Admin": {"Web": 0, "Unix": ""},
	"TLS": {
		"Certificates": {
			"headscale-ca": {"File": "%E2E_RUNTIME%/headscale/ca.crt"}
		},
		"Policies": {
			"headscale": {
				"trust_anchors": [
					{"cert": "headscale-ca", "scope": {"any": true}}
				]
			}
		}
	},
	"Secrets": {
		"headscale-auth-key": {
			"Value": "%HEADSCALE_AUTH_KEY%",
			"Nodes": ["Tailscale A"]
		},
		"wireguard-a-private-key": {
			"Value": "iMBBlzD6x+4ZVFtXGpVr4hwdh8iqvCzPIhy+kE6oh2I=",
			"Nodes": ["WireGuard A"]
		}
	}
}
