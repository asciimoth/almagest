{
	"Logs": {
		"Cache": {
			"Debug": 4096,
			"Info": 512,
			"Warn": 256,
			"Error": 128,
			"Fatal": 32,
		},
	},
	"nodes": {
		"DefaultTun entry": {
			"Class": "almagest/DefaultTun",
			"Pos": "{\"x\":80,\"y\":180}",
			"Links": [
				"Tun -> [Shared TunJoiner] Default",
				"DNS -> [Original OutDns] DNS",
			],
			"tunAddrs": "",
			"tunRoutes": "",
			"mtu": 0,
			"dnsIP": "",
			"strict": false,
			"exclude": [],
			"include": [],
		},
		"Original OutDns": {
			"Class": "almagest/OutDns",
			"Pos": "{\"x\":80,\"y\":360}",
		},
		"Application VTun": {
			"Class": "almagest/VTun",
			"Pos": "{\"x\":80,\"y\":560}",
			"Links": ["Tun -> [Shared TunJoiner] Secondary"],
			"name": "nested-bypass-app",
			"localAddrs": "",
			"dnsServers": "",
			"mtu": 0,
			"endpointCh": 1024,
			"eventCh": 10,
			"noLoopbackAddr": false,
			"disableSACK": false,
		},
		"Shared TunJoiner": {
			"Class": "almagest/TunJoiner",
			"Pos": "{\"x\":360,\"y\":360}",
			"Links": ["Tun -> [Route TunSplitter] Tun"],
		},
		"Route TunSplitter": {
			"Class": "almagest/TunSplitter",
			"Pos": "{\"x\":590,\"y\":360}",
			"Links": ["slot 1 -> [WireGuard tunnel] Tun"],
			"rules": "TRUE\nSLOT 1",
		},
		"WireGuard tunnel": {
			"Class": "almagest/WireGuard",
			"Pos": "{\"x\":820,\"y\":360}",
			"Links": ["Network -> [WireGuard transport log] Network"],
			"privateKeySecret": "nested-bypass-private-key",
			"listenPort": 51880,
			"ownedIPs": "10.250.0.1/32",
			"peers": [{
				"id": "kernel-peer",
				"publicKey": "laFBiTT/wW7x80sMEG6yQhZxM7h0+3hv5kI6dxP081g=",
				"endpoint": "203.0.113.2:51881",
				"allowedIPs": "0.0.0.0/0",
				"persistentKeepaliveInterval": 1,
			}],
		},
		"WireGuard transport log": {
			"Class": "almagest/LogNetwork",
			"Pos": "{\"x\":1060,\"y\":360}",
			"Links": ["Network -> [WireGuard OutNetwork] Network"],
		},
		"WireGuard OutNetwork": {
			"Class": "almagest/OutNetwork",
			"Pos": "{\"x\":1280,\"y\":360}",
		},
		"Tunnel HTTP client": {
			"Class": "almagest/HttpClient",
			"Pos": "{\"x\":-180,\"y\":500}",
			"Links": ["Network -> [Application VTun] Network"],
			"url": "http://10.250.0.2:18091/from-application-vtun",
			"method": "GET",
			"body": "",
		},
		"Tunnel DNS client": {
			"Class": "almagest/DnsClient",
			"Pos": "{\"x\":-180,\"y\":650}",
			"Links": ["Network -> [Application VTun] Network"],
			"servers": ["udp://10.250.0.2:5353"],
		},
		"Tunnel DNS query": {
			"Class": "almagest/DnsQuery",
			"Pos": "{\"x\":-420,\"y\":650}",
			"Links": ["DNS -> [Tunnel DNS client] DNS"],
			"name": "nested-bypass.e2e.test.",
			"type": "A",
		},
		"Direct public HTTP client": {
			"Class": "almagest/HttpClient",
			"Pos": "{\"x\":800,\"y\":650}",
			"Links": ["Network -> [Direct transport log] Network"],
			"url": "http://203.0.113.2:18092/from-outnetwork",
			"method": "GET",
			"body": "",
		},
		"Direct transport log": {
			"Class": "almagest/LogNetwork",
			"Pos": "{\"x\":1060,\"y\":650}",
			"Links": ["Network -> [Direct OutNetwork] Network"],
		},
		"Direct OutNetwork": {
			"Class": "almagest/OutNetwork",
			"Pos": "{\"x\":1280,\"y\":650}",
		},
	},
}
