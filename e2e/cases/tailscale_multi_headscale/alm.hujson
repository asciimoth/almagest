		"Tailscale A1": {
			"Class": "almagest/TailscaleCtrl",
			"Links": [
				"WireGuard -> [WireGuard A1] WGCtrl",
				"Network -> [Control Network A1] Network"
			],
			"controlURL": "https://headscale-a.e2e.internal:18190",
			"tlsConfig": "headscale-a",
			"hostname": "a-one",
