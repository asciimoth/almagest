{
	"Admin": {
		"Web":  0,
		"Unix": "%E2E_ADMIN_SOCK%",
	},
	"CommandRunner": {
		"Commands": {
			"record-interval": {
				"Command": ["/usr/local/bin/almagest-e2e-command-recorder", "/state/time-trigger-interval.log", "interval"],
				"Sync": true,
				"Timeout": 2000000000,
				"AllowNodes": true,
			},
			"record-ready": {
				"Command": ["/usr/local/bin/almagest-e2e-command-recorder", "/state/time-trigger-ready.log", "ready"],
				"Sync": true,
				"Timeout": 2000000000,
				"AllowNodes": true,
			},
		},
	},
}
