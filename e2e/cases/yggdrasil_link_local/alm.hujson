{
  "nodes": {
    "Ygg A": {
      "Class": "almagest/Yggdrasil",
      "Links": ["default -> [OutNetwork] Network"],
      "privateKeySecret": "ygg-a-identity",
      "multicastInterfaces": "[{\"regex\":\"^yga0$\",\"beacon\":true,\"listen\":true,\"port\":0}]"
