{
	"Admin": {
		"Web":  0,
		"Unix": "%E2E_ADMIN_SOCK%",
	},
	"CommandRunner": {
		"Commands": {
			"record-alpha": {
				"Command": [
					"/usr/local/bin/almagest-e2e-command-recorder",
					"/state/command-node.log",
					"alpha",
					"${message}",
					"${optional}",
				],
				"Sync":       true,
				"Timeout":    2000000000,
				"AllowNodes": true,
				"Slots": {
					"message": {
						"MaxLength": 32,
						"Pattern":   "[A-Za-z0-9_-]+",
						"Required":  true,
					},
					"optional": {
						"MaxLength": 32,
						"Pattern":   "[A-Za-z0-9_-]+",
						"AllowEmpty": true,
					},
				},
			},
			"record-beta": {
				"Command": [
					"/usr/local/bin/almagest-e2e-command-recorder",
					"/state/command-node.log",
					"beta",
					"${other}",
				],
				"Sync":       true,
				"Timeout":    2000000000,
				"AllowNodes": true,
				"Slots": {
					"other": {
						"MaxLength": 32,
						"Pattern":   "[A-Za-z0-9_-]+",
						"Required":  true,
					},
				},
			},
			"hidden-command": {
				"Command": ["/usr/local/bin/almagest-e2e-command-recorder", "/state/command-node.log", "hidden"],
				"Sync":    true,
			},
		},
	},
}
