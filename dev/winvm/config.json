{
  "schemaVersion": 1,
  "architecture": "amd64",
  "windowsImageName": "Windows Server 2022 SERVERSTANDARDCORE",
  "machine": {
    "cpus": 4,
    "memoryMiB": 8192,
    "diskGiB": 80,
    "type": "q35,accel=kvm",
    "cpu": "host,cet-ss=off,cet-ibt=off",
    "bootTimeoutSeconds": 1200,
    "installTimeoutSeconds": 5400,
    "testTimeoutSeconds": 3600,
    "resourceTimeoutSeconds": 4500,
    "healthTimeoutSeconds": 120,
    "healthIntervalSeconds": 15,
    "artifactIntervalSeconds": 60,
    "cleanupTimeoutSeconds": 300,
    "recoveryBootTimeoutSeconds": 120,
    "shutdownTimeoutSeconds": 90
  },
  "ssh": {
    "user": "winvm",
    "portMinimum": 22000,
    "portMaximum": 22999
  },
  "artifacts": {
    "directory": "artifacts/winvm",
    "retainFailedOverlay": true
  }
}
